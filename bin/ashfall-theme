#!/usr/bin/env python3
"""ashfall-theme — switch every ASHFALL app to one of the six palettes.

  ashfall-theme                 show current theme and the list
  ashfall-theme <name>          apply a theme (ashfall winter phosphor redzone dust bog)
  ashfall-theme --render        re-apply the current theme (after editing templates)
  ashfall-theme --no-reload     write files only, don't poke running apps
"""
import json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
AF = os.path.join(CFG, "ashfall")
TPL = os.path.join(AF, "templates")
STATE = os.path.join(AF, "state.json")
THEMES = json.load(open(os.path.join(AF, "themes.json")))

OUTPUTS = {  # template -> rendered file
    "kitty-theme.conf": "kitty/theme.conf",
    "waybar-colors.css": "waybar/colors.css",
    "fuzzel.ini": "fuzzel/fuzzel.ini",
    "mako.conf": "mako/config",
    "swaylock.conf": "swaylock/config",
    "btop.theme": "btop/themes/ashfall.theme",
    "starship.toml": "starship.toml",
    "colors.zsh": "ashfall/colors.zsh",
}
SWAP_FILES = ["niri/config.kdl", "waybar/config.jsonc"]  # user-edited files: only swap colour values


def load_state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}


def save_state(st):
    os.makedirs(AF, exist_ok=True)
    tmp = STATE + ".tmp"
    json.dump(st, open(tmp, "w"), indent=1)
    os.replace(tmp, STATE)


def render(text, slots):
    vals = dict(slots, HOME=HOME)
    return re.sub(r"\{\{(\w+)\}\}", lambda m: vals[m.group(1)], text)


def swap_hex(text, old, new):
    table = {old[k].lower(): new[k] for k in old}
    return re.sub(r"#([0-9a-fA-F]{6})", lambda m: "#" + table.get(m.group(1).lower(), m.group(1)), text)


def apply(name, reload=True):
    if name not in THEMES or name.startswith("_"):
        sys.exit(f"unknown theme '{name}'. choose: {', '.join(k for k in THEMES if not k.startswith('_'))}")
    st = load_state()
    prev = st.get("theme", "ashfall")
    slots = THEMES[name]["slots"]
    for tpl, dst in OUTPUTS.items():
        src = os.path.join(TPL, tpl)
        if not os.path.exists(src):
            continue
        dst = os.path.join(CFG, dst)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        open(dst, "w").write(render(open(src).read(), slots))
    if prev in THEMES and prev != name:
        for f in SWAP_FILES:
            p = os.path.join(CFG, f)
            if os.path.exists(p):
                t = open(p).read()
                n = swap_hex(t, THEMES[prev]["slots"], slots)
                if n != t:
                    open(p, "w").write(n)
    json.dump({k: "#" + v for k, v in slots.items()} | {"name": THEMES[name]["name"]},
              open(os.path.join(AF, "palette.json"), "w"), indent=1)
    st["theme"] = name
    save_state(st)
    if reload:
        q = lambda *c: subprocess.run(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        q("pkill", "-SIGUSR2", "-x", "waybar")      # waybar reloads its style
        q("makoctl", "reload")
        q("pkill", "-SIGUSR1", "-x", "kitty")       # kitty re-reads its config
        q("notify-send", "-a", "ASHFALL", "theme", THEMES[name]["name"])
    print(f"theme → {THEMES[name]['name']}")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    reload = "--no-reload" not in sys.argv
    if "--render" in sys.argv:
        return apply(load_state().get("theme", "ashfall"), reload)
    if "--list" in sys.argv:
        print("\n".join(k for k in THEMES if not k.startswith("_")))
        return
    if not args:
        cur = load_state().get("theme", "ashfall")
        for k, v in THEMES.items():
            if k.startswith("_"):
                continue
            print(("▸ " if k == cur else "  ") + f"{k:<9} {v['name']:<16} {v['tag']}")
        return
    apply(args[0], reload)


if __name__ == "__main__":
    main()
