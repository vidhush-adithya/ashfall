#!/usr/bin/env python3
"""ashfall-wall — wallpapers for ASHFALL.

  ashfall-wall list               JSON list of wallpapers (used by the picker)
  ashfall-wall set <name|path>    set wallpaper + its matching theme
  ashfall-wall set <..> --keep-theme   wallpaper only
  ashfall-wall next | random      cycle
  ashfall-wall restore            start swaybg with the saved wallpaper (niri runs this at login)

Your own images: drop them into ~/Pictures/Wallpapers (they show up in the picker).
"""
import json, os, random, subprocess, sys, time

HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
AF = os.path.join(CFG, "ashfall")
STATE = os.path.join(AF, "state.json")
SHARE = os.path.join(HOME, ".local/share/ashfall")
DIRS = [os.path.join(SHARE, "walls"), os.path.join(HOME, "Pictures/Wallpapers")]
THUMBS = os.path.join(HOME, ".cache/ashfall/thumbs")
LOCK = os.path.join(SHARE, "ashfall-lock.png")
EXT = (".jpg", ".jpeg", ".png", ".webp")


def state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}


def save(st):
    os.makedirs(AF, exist_ok=True)
    json.dump(st, open(STATE + ".tmp", "w"), indent=1)
    os.replace(STATE + ".tmp", STATE)


def pairing():
    try:
        return json.load(open(os.path.join(AF, "themes.json"))).get("_wallpapers", {})
    except Exception:
        return {}


def walls():
    out = []
    for d in DIRS:
        if os.path.isdir(d):
            for f in sorted(os.listdir(d)):
                if f.lower().endswith(EXT):
                    out.append(os.path.join(d, f))
    return out


def thumb(path):
    os.makedirs(THUMBS, exist_ok=True)
    t = os.path.join(THUMBS, os.path.splitext(os.path.basename(path))[0] + ".jpg")
    if not os.path.exists(t) or os.path.getmtime(t) < os.path.getmtime(path):
        try:
            from PIL import Image
            im = Image.open(path).convert("RGB")
            im.thumbnail((480, 480))
            im.save(t, quality=82)
        except Exception:
            return path
    return t


def resolve(arg):
    if os.path.isfile(arg):
        return os.path.abspath(arg)
    for p in walls():
        if os.path.splitext(os.path.basename(p))[0] == arg:
            return p
    sys.exit(f"no wallpaper named '{arg}' (try: ashfall-wall list)")


def start_swaybg(path):
    old = subprocess.run(["pgrep", "-x", "swaybg"], capture_output=True, text=True).stdout.split()
    try:
        subprocess.Popen(["swaybg", "-m", "fill", "-i", path], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        sys.exit("swaybg is not installed")
    time.sleep(0.4)  # let the new one draw before removing the old (no black flash)
    for pid in old:
        subprocess.run(["kill", pid], stderr=subprocess.DEVNULL)


def make_lock(path):
    try:
        from PIL import Image, ImageFilter, ImageEnhance
        im = Image.open(path).convert("RGB")
        im.thumbnail((1920, 1920))
        im = im.filter(ImageFilter.GaussianBlur(16))
        ImageEnhance.Brightness(im).enhance(0.55).save(LOCK + ".tmp.png")
        os.replace(LOCK + ".tmp.png", LOCK)
    except Exception:
        pass


def set_wall(path, keep_theme=False):
    st = state()
    st["wallpaper"] = path
    save(st)
    start_swaybg(path)
    name = os.path.splitext(os.path.basename(path))[0]
    theme = pairing().get(name)
    if theme and not keep_theme and theme != st.get("theme"):
        subprocess.run(["ashfall-theme", theme])
    make_lock(path)


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "list"
    if cmd == "list":
        cur = state().get("wallpaper", "")
        pair = pairing()
        print(json.dumps([{
            "path": p, "name": os.path.splitext(os.path.basename(p))[0], "thumb": thumb(p),
            "theme": pair.get(os.path.splitext(os.path.basename(p))[0], ""), "current": p == cur,
        } for p in walls()]))
    elif cmd == "set" and len(a) > 1:
        set_wall(resolve(a[1]), "--keep-theme" in a)
    elif cmd in ("next", "random"):
        ws = walls()
        if not ws:
            sys.exit("no wallpapers found")
        cur = state().get("wallpaper")
        if cmd == "random":
            p = random.choice([w for w in ws if w != cur] or ws)
        else:
            p = ws[(ws.index(cur) + 1) % len(ws)] if cur in ws else ws[0]
        set_wall(p, "--keep-theme" in a)
    elif cmd == "restore":
        p = state().get("wallpaper")
        if not p or not os.path.exists(p):
            ws = walls()
            p = next((w for w in ws if "sector07-ashfall" in w), ws[0] if ws else None)
        if p:
            start_swaybg(p)
            if not os.path.exists(LOCK):
                make_lock(p)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
